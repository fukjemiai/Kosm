      "firstName": "Petra",
      "lastName": "Horáková",
      "credentials": [{ "type": "password", "value": "Password1!", "temporary": false }],
      "realmRoles": ["salon_manager"],
      "attributes": { "org_id": ["00000000-0000-0000-0000-000000000001"], "staff_role": ["MANAGER"] }
    },
    {
      "username": "stylist@kosm.local",
      "email": "stylist@kosm.local",
      "emailVerified": true,
