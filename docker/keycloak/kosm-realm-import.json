      "credentials": [{ "type": "password", "value": "Password1!", "temporary": false }],
      "realmRoles": ["staff"],
      "attributes": { "org_id": ["00000000-0000-0000-0000-000000000001"], "staff_role": ["STYLIST"] }
    },
    {
      "username": "junior@kosm.local",
      "email": "junior@kosm.local",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Lucie",
      "lastName": "Benešová",
      "credentials": [{ "type": "password", "value": "Password1!", "temporary": false }],
      "realmRoles": ["staff"],
      "attributes": { "org_id": ["00000000-0000-0000-0000-000000000001"], "staff_role": ["JUNIOR"] }
    },
    {
      "username": "accountant@kosm.local",
      "email": "accountant@kosm.local",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Hana",
      "lastName": "Černá",
      "credentials": [{ "type": "password", "value": "Password1!", "temporary": false }],
      "realmRoles": ["accountant"],
