    },
    {
      "username": "customer@kosm.local",
      "email": "customer@kosm.local",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Marie",
      "lastName": "Svobodová",
      "credentials": [{ "type": "password", "value": "Password1!", "temporary": false }],
      "realmRoles": ["customer"]
    }
  ]
}
