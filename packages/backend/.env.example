# ── Database ─────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=kosm
DB_PASSWORD=kosm_dev
DB_NAME=kosm
DB_LOGGING=false

# ── Keycloak (externí instance) ──────────────
KEYCLOAK_URL=https://auth.localhost
KEYCLOAK_REALM=kosm
KEYCLOAK_CLIENT_ID=kosm-api

# ── JWT ──────────────────────────────────────
JWT_ISSUER=https://auth.localhost/realms/kosm

# ── App ──────────────────────────────────────
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Mail ─────────────────────────────────────
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=noreply@kosm.local

# ── Guest Token ──────────────────────────────
GUEST_TOKEN_SECRET=change-me-in-production
GUEST_TOKEN_EXPIRY_HOURS=72
